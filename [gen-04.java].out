metprintS@System: LOADFP ; apila el valor del registro fp
LOADSP ; apila el valor del registro sp
STOREFP ; almacena el tope de la pila en el registro fp
LOAD 3  ; Apila el parámetro
PUSH 1
ADD
SPRINT
STOREFP ; almacena el tope de la pila en el registro
RET 1

metprintln@System: LOADFP ; apila el valor del registro fp
LOADSP ; apila el valor del registro sp
STOREFP ; almacena el tope de la pila en el registro fp
RMEM 0 ; reservo celdas de memoria para las vars locales
FMEM 0 ; libero las celdas de memoria de las vars locales
STOREFP ; almacena el tope de la pila en el registro
RET 0

metprintCln@System: LOADFP ; apila el valor del registro fp
LOADSP ; apila el valor del registro sp
